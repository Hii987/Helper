# Clé API Groq (gratuite) : https://console.groq.com/keys
GROQ_API_KEY=
# Modèle utilisé pour résumer les offres
GROQ_MODEL=openai/gpt-oss-120b

# Firestore : identifiant du projet Firebase et chemin de la clé du compte de service (JSON)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optionnel : API Offres d'emploi de France Travail (gratuite) : https://francetravail.io
# Sans ces identifiants, la recherche propose des liens directs vers les sites d'offres.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
