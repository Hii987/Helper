# Clé API Groq (gratuite) : https://console.groq.com/keys
GROQ_API_KEY=
# Modèle utilisé (résumé des offres, réponses de recruteurs, préparation d'entretien, assistant, rédaction)
GROQ_MODEL=openai/gpt-oss-120b

# Firestore : identifiant du projet Firebase et chemin de la clé du compte de service (JSON)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Recommandé : moteur de recherche web Tavily (gratuit jusqu'à 1 000 recherches par mois, sans carte bancaire).
# Clé sur https://app.tavily.com. Sans elle, l'appli utilise DuckDuckGo, qui bloque souvent les requêtes automatiques.
TAVILY_API_KEY=

# Optionnel : API Offres d'emploi de France Travail (gratuite) : https://francetravail.io
# Sans ces identifiants, la recherche propose des liens directs vers les sites d'offres.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Statistiques d'usage : identifiants Firebase (uid) autorisés à voir la page Statistiques,
# séparés par des virgules. Chacun trouve son identifiant en bas de sa page Profil.
ADMIN_UIDS=

# Optionnel : envoyer aussi les événements à PostHog (https://posthog.com, clé « Project API key »).
# Seuls les utilisateurs qui ont accepté les statistiques sont suivis.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
