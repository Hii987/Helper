# Clé API Mistral (gratuite avec le plan "Experiment") : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Modèle utilisé (mistral-small-latest est rapide et disponible sur le plan gratuit)
MISTRAL_MODEL=mistral-small-latest

# Optionnel : API Offres d'emploi de France Travail (gratuite) : https://francetravail.io
# Sans ces identifiants, la recherche propose des liens directs vers les sites d'offres.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Fichier de base de données SQLite (profil + suivi des candidatures)
HELPER_DB_PATH=helper.db
